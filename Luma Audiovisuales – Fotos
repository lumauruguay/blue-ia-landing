@charset "utf-8";

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

:root { --bg: #ffffff; --text: #111111; --muted: #555555; --border: #dddddd; --red: #cc0000; --red-hover: #ff0000; }

body { background: var(--bg); color: var(--text); font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; min-height: 100vh; }

header { border-bottom: 1px solid var(--border); padding: 28px 40px 20px; display: flex; align-items: baseline; gap: 12px; }

header h1 { font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

header span { color: var(--red); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; }

nav { padding: 0px 40px; border-bottom: 1px solid var(--border); display: flex; overflow-x: auto; }

nav button { background: none; border-width: medium medium 2px; border-style: none none solid; border-color: currentcolor currentcolor transparent; border-image: none; padding: 14px 20px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; color: var(--muted); white-space: nowrap; transition: color 0.15s, border-color 0.15s; }

nav button:hover { color: var(--text); }

nav button.active { color: var(--text); border-bottom-color: var(--red); font-weight: 600; }

main { padding: 36px 40px; max-width: 1100px; }

.event-panel { display: none; }

.event-panel.active { display: block; }

.event-meta { margin-bottom: 28px; max-width: 600px; }

.event-meta h2 { font-size: 1rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 4px; }

.event-meta .date { font-size: 0.78rem; color: var(--red); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px; }

.event-meta p { font-size: 0.9rem; color: var(--muted); line-height: 1.65; }

.photo-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 40px; }

.photo-item { position: relative; width: 250px; height: 167px; cursor: pointer; overflow: hidden; border: 2px solid transparent; transition: border-color 0.15s; flex-shrink: 0; user-select: none; }

.photo-item img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; -webkit-user-drag: none; }

.photo-item::before { content: attr(data-code); position: absolute; top: 6px; right: 6px; background: rgba(0, 0, 0, 0.55); color: rgb(255, 255, 255); font-size: 0.65rem; letter-spacing: 0.08em; padding: 2px 5px; pointer-events: none; z-index: 2; }

.photo-item.selected { border-color: var(--red); }

.photo-item.selected::after { content: attr(data-code); position: absolute; bottom: 0px; left: 0px; right: 0px; background: rgba(204, 0, 0, 0.88); color: rgb(255, 255, 255); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-align: center; padding: 4px 0px; }

#cart-bar { position: fixed; bottom: 0px; left: 0px; right: 0px; background: var(--bg); border-top: 1px solid var(--border); padding: 14px 40px; display: flex; align-items: center; justify-content: space-between; gap: 16px; z-index: 100; transform: translateY(100%); transition: transform 0.25s; }

#cart-bar.visible { transform: translateY(0px); }

#cart-summary { font-size: 0.82rem; color: var(--muted); }

#cart-summary strong { color: var(--text); }

#cart-codes { font-size: 0.78rem; color: var(--red); letter-spacing: 0.06em; flex: 1 1 0%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

#btn-whatsapp { background: var(--red); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 10px 22px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; transition: background 0.15s; white-space: nowrap; }

#btn-whatsapp:hover { background: var(--red-hover); }

#btn-clear { background: none; border: 1px solid var(--border); color: var(--muted); padding: 10px 14px; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; transition: border-color 0.15s, color 0.15s; }

#btn-clear:hover { border-color: var(--red); color: var(--red); }

footer { padding: 60px 40px 100px; font-size: 0.72rem; color: var(--border); letter-spacing: 0.06em; }

footer a { color: var(--red); text-decoration: none; }

footer a:hover { text-decoration: underline; }

@media (max-width: 600px) {
  header, nav, main { padding-left: 16px; padding-right: 16px; }
  .photo-item { width: 160px; height: 107px; }
  #cart-bar { padding: 12px 16px; }
}
